local function createFeatureToggle(parentPage, text, callback)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, -10, 0, 40)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(24, 18, 36)
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = parentPage

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(0, 6)
    tCorner.Parent = toggleFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 200, 255)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = toggleFrame

    local statusBtn = Instance.new("TextButton")
    statusBtn.Size = UDim2.new(0, 60, 0, 24)
    statusBtn.Position = UDim2.new(1, -70, 0.5, -12)
    statusBtn.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
    statusBtn.Text = "OFF"
    statusBtn.TextColor3 = Color3.fromRGB(170, 140, 210)
    statusBtn.Font = Enum.Font.GothamBold
    statusBtn.TextSize = 12
    statusBtn.Parent = toggleFrame

    local sCorner = Instance.new("UICorner")
    sCorner.CornerRadius = UDim.new(0, 4)
    sCorner.Parent = statusBtn

    local active = false
    statusBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            statusBtn.Text = "ON"
            statusBtn.BackgroundColor3 = Color3.fromRGB(110, 60, 180)
            statusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            statusBtn.Text = "OFF"
            statusBtn.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
            statusBtn.TextColor3 = Color3.fromRGB(170, 140, 210)
        end
        if callback then
            callback(active)
        end
    end)
end

local remotesFolder = ReplicatedStorage:FindFirstChild("PaperPlaneRemotes")
local trainingRemote = remotesFolder and remotesFolder:FindFirstChild("Training")
local rebirthRemote = remotesFolder and remotesFolder:FindFirstChild("Rebirth")

local trainingEnabled = false
local rebirthEnabled = false

-- Tọa độ chính xác ô training của bạn
local targetTrainingCFrame = CFrame.new(-5681.12109, 1463.79712, -881.900024, -1, 0, 0, 0, 1, 0, 0, 0, -1)

getgenv().izHubRoutine = task.spawn(function()
    while true do
        if trainingEnabled then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.CFrame = targetTrainingCFrame
            end
            if trainingRemote then
                pcall(function()
                    trainingRemote:FireServer()
                end)
            end
        end
        
        if rebirthEnabled and rebirthRemote then
            pcall(function()
                rebirthRemote:FireServer()
            end)
        end
        
        task.wait(0.2)
    end
end)

createFeatureToggle(mainPage, "Auto Training", function(state)
    trainingEnabled = state
end)

createFeatureToggle(mainPage, "Auto Rebirth", function(state)
    rebirthEnabled = state
end)

createFeatureToggle(mainPage, "Auto Buy Best Item", function(state) end)

local antiAfkConnection = nil
createFeatureToggle(settingsPage, "Anti-AFK", function(state)
    if state then
        antiAfkConnection = player.Idled:Connect(function()
            VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        end)
    else
        if antiAfkConnection then
            antiAfkConnection:Disconnect()
            antiAfkConnection = nil
        end
    end
end)

