titleLabel.TextColor3 = Color3.fromRGB(130, 195, 255)
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 14
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Parent = mainFrame
local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 10)
titleCorner.Parent = titleLabel
local autoThrowBtn = Instance.new("TextButton")
autoThrowBtn.Name = "AutoThrowButton"
autoThrowBtn.Size = UDim2.new(0.86, 0, 0, 42)
autoThrowBtn.Position = UDim2.new(0.07, 0, 0, 55)
autoThrowBtn.BackgroundColor3 = Color3.fromRGB(20, 35, 60)
autoThrowBtn.Text = "Auto Throw: OFF"
autoThrowBtn.TextColor3 = Color3.fromRGB(220, 235, 255)
autoThrowBtn.Font = Enum.Font.GothamSemibold
autoThrowBtn.TextSize = 14
autoThrowBtn.Parent = mainFrame
local throwCorner = Instance.new("UICorner")
throwCorner.CornerRadius = UDim.new(0, 8)
throwCorner.Parent = autoThrowBtn
local autoBuyBtn = Instance.new("TextButton")
autoBuyBtn.Name = "AutoBuyButton"
autoBuyBtn.Size = UDim2.new(0.86, 0, 0, 42)
autoBuyBtn.Position = UDim2.new(0.07, 0, 0, 112)
autoBuyBtn.BackgroundColor3 = Color3.fromRGB(20, 35, 60)
autoBuyBtn.Text = "Auto Buy: OFF"
autoBuyBtn.TextColor3 = Color3.fromRGB(220, 235, 255)
autoBuyBtn.Font = Enum.Font.GothamSemibold
autoBuyBtn.TextSize = 14
autoBuyBtn.Parent = mainFrame
local buyCorner = Instance.new("UICorner")
buyCorner.CornerRadius = UDim.new(0, 8)
buyCorner.Parent = autoBuyBtn
local isAutoThrowing = false
local isAutoBuying = false
local colorOff = Color3.fromRGB(20, 35, 60)
local colorOn = Color3.fromRGB(25, 115, 210)
openButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
end)
autoThrowBtn.MouseButton1Click:Connect(function()
	isAutoThrowing = not isAutoThrowing
	if isAutoThrowing then
		autoThrowBtn.Text = "Auto Throw: ON"
		autoThrowBtn.BackgroundColor3 = colorOn
	else
		autoThrowBtn.Text = "Auto Throw: OFF"
		autoThrowBtn.BackgroundColor3 = colorOff
	end
end)
task.spawn(function()
	while true do
		if isAutoThrowing then
			local remote = ReplicatedStorage:FindFirstChild("ThrowPlaneEvent")
			if remote then
				remote:FireServer()
			end
		end
		task.wait(0.5)
	end
end)
autoBuyBtn.MouseButton1Click:Connect(function()
	isAutoBuying = not isAutoBuying
	if isAutoBuying then
		autoBuyBtn.Text = "Auto Buy: ON"
		autoBuyBtn.BackgroundColor3 = colorOn
	else
		autoBuyBtn.Text = "Auto Buy: OFF"
		autoBuyBtn.BackgroundColor3 = colorOff
	end
end)
task.spawn(function()
	while true do
		if isAutoBuying then
			local buyRemote = ReplicatedStorage:FindFirstChild("BuyItemEvent")
			if buyRemote then
				buyRemote:FireServer("BestItemAvailable")
			end
		end
		task.wait(1)
	end
end)
